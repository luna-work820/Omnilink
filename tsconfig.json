{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@phosphor-icons/react": [
        "./components/ui/line-icons/phosphor"
      ],
      "@hugeicons/react": [
        "./components/ui/line-icons/hugeicons"
      ],
      "@hugeicons/core-free-icons": [
        "./components/ui/line-icons/hugeicons-data"
      ],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "**/*.mts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "archive/**",
    "scripts/**/*.mts",
    "**/__tests__/**",
    "**/*.test.ts"
  ]
}
