GEMINI_API_KEY=
GEMINI_MODEL=
# Optional Qwen / Bailian text model configuration
DASHSCOPE_API_KEY=
BAILIAN_WORKSPACE_ID=
DASHSCOPE_BASE_URL=
# Search intent parser: qwen-plus (default), gemini, or deepseek-flash.
CONSUMER_PARSER_MODEL=
# Default answer model when a user has not connected DeepSeek: qwen-plus or gemini.
CONSUMER_DEFAULT_ANSWER_MODEL=
# Local BGE embedding model. Defaults to the Omnilink SSD model directory and python3.
CONSUMER_BGE_MODEL_DIR=
CONSUMER_BGE_PYTHON=python3
# Server-only scraping credentials. Leave unused providers empty.
FIRECRAWL_API_KEY=
APIFY_TOKEN=
# Optional offline fallback: fixture. Omit to read the published database catalog.
CONSUMER_CATALOG_SOURCE=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
# Optional CI overrides for the Cloudflare Preview. URL must point to omnilink-dev.
OMNILINK_PREVIEW_SUPABASE_URL=
OMNILINK_PREVIEW_SUPABASE_ANON_KEY=
# Server-only. Used exclusively by the trusted service-role client
# (lib/supabase/service-role) to read SERVICE_ROLE_ONLY reference data such as
# semantic_schemas. NEVER expose this to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
# AI website builds run only in Vercel Sandbox. Local development can use
# `vercel env pull` for a short-lived OIDC token; refresh it when expired.
VERCEL_OIDC_TOKEN=
# Alternative server-only Sandbox authentication (all three required).
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# HTTPS origin serving the deployed /api/site-data/v1 routes. Required to publish.
SITE_DATA_ORIGIN=
